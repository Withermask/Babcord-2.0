# Babcord Windows host configuration template.
# Copy this file to C:\ProgramData\Babcord\config\babcord.env by running
# deployment\scripts\Initialize-BabcordHost.ps1. Never commit the generated file.

NODE_ENV=production
BABCORD_HOST=127.0.0.1
BABCORD_PORT=8080
BABCORD_PUBLIC_URL=https://babcord.withermask.net
BABCORD_WEB_ORIGIN=https://babcord.withermask.net
BABCORD_SERVER_ENTRY=server/src/index.mjs
BABCORD_CLIENT_DIR=.\client
# Direct hosting may set this to the permanent GitHub raw launcher URL. It is
# intentionally a launcher URL, never a server address or secret.
BABCORD_CLIENT_DOWNLOAD_URL=

# Use a local, fixed NTFS disk. Do not place live data in OneDrive or another
# synchronised folder.
BABCORD_DATA_DIR=C:\ProgramData\Babcord\data
BABCORD_DATABASE_PATH=C:\ProgramData\Babcord\data\babcord.sqlite
BABCORD_BACKUP_DIR=C:\ProgramData\Babcord\backups
BABCORD_EXPORT_DIR=C:\ProgramData\Babcord\exports
BABCORD_LOG_DIR=C:\ProgramData\Babcord\logs
BABCORD_STATE_DIR=C:\ProgramData\Babcord\state

# Product policy: protected log content is retained for 30 rolling days and
# global admins are warned daily during the final 5 days before each purge.
BABCORD_LOG_RETENTION_DAYS=30
BABCORD_LOG_WARNING_DAYS=5
BABCORD_LOG_WARNING_HOUR=9

# Disaster-recovery snapshots contain sensitive content. Fourteen days limits
# how long already-purged content can remain in routine backups.
BABCORD_BACKUP_RETENTION_DAYS=14

# The backend accepts Origin: null for the file:// launcher plus WEB_ORIGIN.
BABCORD_SESSION_DAYS=30
BABCORD_REGISTRATION_RATE_LIMIT_PER_HOUR=30
BABCORD_MAX_IMAGE_BYTES=5242880
BABCORD_MAX_FILE_BYTES=10485760

# Initialize-BabcordHost.ps1 replaces these placeholders in the private file.
# Do not put real values in this example.
BABCORD_SECRET=GENERATED_DURING_SETUP
BABCORD_RECOVERY_PEPPER=GENERATED_DURING_SETUP
BABCORD_ADMIN_USERNAME=CHOOSE_DURING_SETUP
BABCORD_ADMIN_PASSWORD=CHOOSE_DURING_SETUP

# Babcord direct-to-home HTTPS configuration.
# Initialize-BabcordDirectHost.ps1 copies this to the protected ProgramData
# config folder. Never put a GitHub token in this file.

# Caddy terminates public HTTPS on 80/443 and forwards only to Babcord's
# loopback listener. Setup fills this with the discovered caddy.exe path.
BABCORD_DIRECT_CADDY_PATH=C:\Program Files\Caddy\caddy.exe
BABCORD_DIRECT_STATE_DIR=C:\ProgramData\Babcord\direct
BABCORD_DIRECT_OUTPUT_DIR=C:\ProgramData\Babcord\direct\release

# Default: the detected IPv4 is embedded in a DNS name such as
# babcord-203-0-113-10.sslip.io. sslip.io is an independent third-party DNS
# service; replace the suffix only with another compatible IP-encoded service.
BABCORD_DIRECT_HOST_PREFIX=babcord
BABCORD_DIRECT_DNS_SUFFIX=sslip.io

# Advanced override. Leave blank for the safe default above. A normal custom
# hostname requires you to keep its DNS pointed at the home IP. A raw IP value
# also requires both trusted TLS files below; plaintext is never generated.
BABCORD_DIRECT_PUBLIC_HOST=
BABCORD_DIRECT_TLS_CERT_FILE=
BABCORD_DIRECT_TLS_KEY_FILE=

# GitHub repository used only to distribute the complete local-client HTML and
# the address-free update descriptor. The fine-grained token is stored in the
# separate ACL-protected token file and needs Contents: read/write for this one
# repository. It must never be entered on this line or committed.
BABCORD_GITHUB_OWNER=
BABCORD_GITHUB_REPOSITORY=
BABCORD_GITHUB_BRANCH=main
BABCORD_GITHUB_RELEASES_PATH=releases
BABCORD_GITHUB_MANIFEST_PATH=releases/latest.json
BABCORD_GITHUB_TOKEN_FILE=C:\ProgramData\Babcord\config\github-token.txt

